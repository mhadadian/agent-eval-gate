# Copy to .env. Only the key is required; everything else has a code default (settings.py).
ANTHROPIC_API_KEY=sk-ant-...

# --- judge ---
# JUDGE_MODEL=claude-fable-5-1
# JUDGE_FALLBACKS=true          # server-side refusal fallback
# JUDGE_EFFORT=high              # low | medium | high | xhigh | max
# JUDGE_MAX_TOKENS=16000
# JUDGE_PROMPT_VERSION=p1        # bump to invalidate cached judgements after a prompt change
# JUDGE_CACHE=judge_cache.json
# JUDGE_OFFLINE=false            # true = never call the API, use the cache only

# --- traces ---
# BASELINE_VERSION=v2.4
# CANDIDATE_VERSION=v2.5

# --- gate ---
# GATE_VERDICT_DROP=2            # review verdict drop that counts as a regression
# GATE_REQUIRE_JUDGE_AGREEMENT=true
